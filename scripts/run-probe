#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd "$script_dir/.." && pwd)"

probe_dir="${ACTION_PROBES_DIR:-$repo_root/../actionc/experiments/original-compiler-probes}"
output_dir="${ACTION_VM_OUTPUT_DIR:-$probe_dir/outputs/vm}"
symbol_output_dir="${ACTION_VM_SYMBOL_OUTPUT_DIR:-$output_dir}"
original_dir="${ACTION_ORIGINAL_OUTPUT_DIR:-$probe_dir/outputs/original}"
cart_rom="${ACTION_VM_CART:-}"
os_rom="${ACTION_VM_OS:-}"
max_steps="${ACTION_VM_MAX_STEPS:-60000000}"

probe_names="
abi_calls
abi_system_call
argthr
arith
array_assign
array_fixed_origin
array_inline_boundary
array_inline_global_threshold
array_inline_local_threshold
array_inline_threshold
array_params
array_refs
arrays
bools
booleq
boolthen
boolword
bool_edges
control_flow
eval_order_args
eval_order_arith
eval_order_compare
eval_order_cmpu
eval_order_index
external_call
drawframe
empty_proc
fnamecmp
functions
graphics_calls
index_scaling
large_local_arrays
layout_order
locarr
locals
nested_calls
optional_args
pointers
precode_zp
record_args
record_ptr_order
records
resident_file
resident_graphics_game
resident_input
resident_misc_memory
resident_output
resident_string_convert
retflow
returns
sargs
signedge
stridx
strinit
strlit
strloc
strmut
strnam
strpass
tn_value_index
ywalk
"

probe_source() {
  case "$1" in
    abi_calls) echo abi_calls.act ;;
    abi_system_call) echo abi_system_call.act ;;
    argthr) echo argthr.act ;;
    arith) echo arith.act ;;
    array_assign) echo array_assign.act ;;
    array_fixed_origin) echo array_fixed_origin.act ;;
    array_inline_boundary) echo array_inline_boundary.act ;;
    array_inline_global_threshold) echo array_inline_global_threshold.act ;;
    array_inline_local_threshold) echo array_inline_local_threshold.act ;;
    array_inline_threshold) echo array_inline_threshold.act ;;
    array_params) echo array_params.act ;;
    array_refs) echo array_refs.act ;;
    arrays) echo arrays.act ;;
    bools) echo bools.act ;;
    booleq) echo booleq.act ;;
    boolthen) echo boolthen.act ;;
    boolword) echo boolword.act ;;
    bool_edges) echo bool_edges.act ;;
    control_flow) echo control_flow.act ;;
    eval_order_args) echo eval_order_args.act ;;
    eval_order_arith) echo eval_order_arith.act ;;
    eval_order_compare) echo eval_order_compare.act ;;
    eval_order_cmpu) echo eval_order_cmpu.act ;;
    eval_order_index) echo eval_order_index.act ;;
    external_call) echo external_call.act ;;
    drawframe) echo drawframe.act ;;
    empty_proc) echo empty_proc.act ;;
    fnamecmp) echo fnamecmp.act ;;
    functions) echo functions.act ;;
    graphics_calls) echo graphics_calls.act ;;
    index_scaling) echo index_scaling.act ;;
    large_local_arrays) echo large_local_arrays.act ;;
    layout_order) echo layout_order.act ;;
    locarr) echo locarr.act ;;
    locals) echo locals.act ;;
    nested_calls) echo nested_calls.act ;;
    optional_args) echo optional_args.act ;;
    pointers) echo pointers.act ;;
    precode_zp) echo precode_zp.act ;;
    record_args) echo record_args.act ;;
    record_ptr_order) echo record_ptr_order.act ;;
    records) echo records.act ;;
    resident_file) echo resident_file.act ;;
    resident_graphics_game) echo resident_graphics_game.act ;;
    resident_input) echo resident_input.act ;;
    resident_misc_memory) echo resident_misc_memory.act ;;
    resident_output) echo resident_output.act ;;
    resident_string_convert) echo resident_string_convert.act ;;
    retflow) echo retflow.act ;;
    returns) echo returns.act ;;
    sargs) echo sargs.act ;;
    signedge) echo signedge.act ;;
    stridx) echo stridx.act ;;
    strinit) echo strinit.act ;;
    strlit) echo strlit.act ;;
    strloc) echo strloc.act ;;
    strmut) echo strmut.act ;;
    strnam) echo strnam.act ;;
    strpass) echo strpass.act ;;
    tn_value_index) echo tn_value_index.act ;;
    ywalk) echo ywalk.act ;;
    *) return 1 ;;
  esac
}

probe_output() {
  case "$1" in
    abi_calls) echo ABICALLS.COM ;;
    abi_system_call) echo ABISYS.COM ;;
    argthr) echo ARGTHR.COM ;;
    arith) echo ARITH.COM ;;
    array_assign) echo ARRASN.COM ;;
    array_fixed_origin) echo ARRFIX.COM ;;
    array_inline_boundary) echo ARRTHB.COM ;;
    array_inline_global_threshold) echo ARRTHG.COM ;;
    array_inline_local_threshold) echo ARRTHL.COM ;;
    array_inline_threshold) echo ARRTHR.COM ;;
    array_params) echo ARRPAR.COM ;;
    array_refs) echo ARRREF.COM ;;
    arrays) echo ARRAYS.COM ;;
    bools) echo BOOLS.COM ;;
    booleq) echo BOOLEQ.COM ;;
    boolthen) echo BOOLTHEN.COM ;;
    boolword) echo BOOLWORD.COM ;;
    bool_edges) echo BOOLEDGE.COM ;;
    control_flow) echo CONTROL.COM ;;
    eval_order_args) echo EVALARG.COM ;;
    eval_order_arith) echo EVALARI.COM ;;
    eval_order_compare) echo EVALCMP.COM ;;
    eval_order_cmpu) echo EVALCMPU.COM ;;
    eval_order_index) echo EVALIDX.COM ;;
    external_call) echo EXTCALL.COM ;;
    drawframe) echo DRAWFRM.COM ;;
    empty_proc) echo EMPTYPR.COM ;;
    fnamecmp) echo FNAMECMP.COM ;;
    functions) echo FUNC.COM ;;
    graphics_calls) echo GRCALL.COM ;;
    index_scaling) echo IDXSCALE.COM ;;
    large_local_arrays) echo LGLARR.COM ;;
    layout_order) echo LAYOUT.COM ;;
    locarr) echo LOCARR.COM ;;
    locals) echo LOCALS.COM ;;
    nested_calls) echo NESTED.COM ;;
    optional_args) echo OPTARGS.COM ;;
    pointers) echo POINTERS.COM ;;
    precode_zp) echo PREZP.COM ;;
    record_args) echo RECARGS.COM ;;
    record_ptr_order) echo RECPTRO.COM ;;
    records) echo RECORDS.COM ;;
    resident_file) echo RESFILE.COM ;;
    resident_graphics_game) echo RESGFX.COM ;;
    resident_input) echo RESIN.COM ;;
    resident_misc_memory) echo RESMISC.COM ;;
    resident_output) echo RESOUT.COM ;;
    resident_string_convert) echo RESSTR.COM ;;
    retflow) echo RETFLOW.COM ;;
    returns) echo RETURNS.COM ;;
    sargs) echo SARGS.COM ;;
    signedge) echo SIGNEDGE.COM ;;
    stridx) echo STRIDX.COM ;;
    strinit) echo STRINIT.COM ;;
    strlit) echo STRLIT.COM ;;
    strloc) echo STRLOC.COM ;;
    strmut) echo STRMUT.COM ;;
    strnam) echo STRNAM.COM ;;
    strpass) echo STRPASS.COM ;;
    tn_value_index) echo TNVAL.COM ;;
    ywalk) echo YWALK.COM ;;
    *) return 1 ;;
  esac
}

probe_host_source() {
  case "$1" in
    array_inline_boundary) echo ARRTHB.ACT ;;
    array_inline_global_threshold) echo ARRTHG.ACT ;;
    array_inline_local_threshold) echo ARRTHL.ACT ;;
    array_inline_threshold) echo ARRTHR.ACT ;;
    *) probe_source "$1" | tr '[:lower:]' '[:upper:]' ;;
  esac
}

probe_expected_compile_failure() {
  case "$1" in
    eval_order_args) return 0 ;;
    eval_order_arith) return 0 ;;
    record_ptr_order) return 0 ;;
    *) return 1 ;;
  esac
}

usage() {
  cat <<EOF
Usage:
  scripts/run-probe <probe-name> [<probe-name> ...]
  scripts/run-probe all
  scripts/run-probe --list

Environment:
  ACTION_PROBES_DIR          Probe source directory
  ACTION_VM_OUTPUT_DIR       Output directory for VM-generated .COM files
  ACTION_VM_SYMBOL_OUTPUT_DIR Output directory for VM symbol JSON files
  ACTION_ORIGINAL_OUTPUT_DIR Original .COM directory for cmp summaries
  ACTION_VM_CART             Optional cartridge override; bundled Action! 3.6 is the default
  ACTION_VM_OS               Optional Atari OS ROM override; bundled AltirraOS is the default
  ACTION_VM_MAX_STEPS        Max VM steps per probe, default 60000000
EOF
}

list_probes() {
  printf '%s\n' "$probe_names" | sed '/^$/d' | sort
}

require_file() {
  local path="$1"
  local label="$2"
  if [[ ! -f "$path" ]]; then
    echo "missing $label: $path" >&2
    exit 1
  fi
}

run_probe() {
  local probe="$1"
  local source_name
  local output_name

  if ! source_name="$(probe_source "$probe")" || ! output_name="$(probe_output "$probe")"; then
    echo "unknown probe: $probe" >&2
    echo "known probes:" >&2
    list_probes >&2
    exit 1
  fi

  local source_path="$probe_dir/$source_name"
  local output_path="$output_dir/$output_name"
  local symbol_path="$symbol_output_dir/${output_name%.COM}.symbols.json"
  local symbol_snapshots_path="$symbol_output_dir/${output_name%.COM}.symbol-snapshots.json"
  local original_path="$original_dir/$output_name"
  local h_source
  local monitor_input
  h_source="$(probe_host_source "$probe")"
  printf -v monitor_input 'C "H:%s"\nW "H:%s"\n' "$h_source" "$output_name"

  require_file "$source_path" "probe source"
  mkdir -p "$output_dir" "$symbol_output_dir"
  rm -f "$output_path"
  rm -f "$symbol_path"
  rm -f "$symbol_snapshots_path"

  echo "==> $probe: $source_name -> $output_name"
  (
    cd "$repo_root"
    vm_command=(
      cargo run --quiet -- run
      --hotpatch action-q-input
      --hotpatch action-headless-getkey
      --host-file "$h_source:$source_path"
      --host-output "$output_name:$output_path"
      --dump-symbols-on-stop "$symbol_path"
      --dump-symbol-snapshots-on-stop "$symbol_snapshots_path"
      --action-symbol-hooks
      --monitor-key-at-pc '$A2E0'
      --q-input-at-pc-after '$A2E0:$B2F5:'"$monitor_input"
      --max-steps "$max_steps"
      --history 20
    )
    if [[ -n "$cart_rom" ]]; then
      vm_command+=(--cart "$cart_rom")
    fi
    if [[ -n "$os_rom" ]]; then
      vm_command+=(--os "$os_rom")
    fi
    "${vm_command[@]}"
  )

  if [[ ! -s "$output_path" ]]; then
    if probe_expected_compile_failure "$probe"; then
      rm -f "$output_path"
      echo "    expected original compiler failure; no output file written"
      return 0
    fi
    echo "FAILED: $output_path was not written or is empty" >&2
    exit 1
  fi

  local size
  size="$(wc -c < "$output_path" | tr -d ' ')"
  if [[ -f "$original_path" ]]; then
    if cmp -s "$original_path" "$output_path"; then
      echo "    wrote $size bytes; matches original"
    else
      echo "    wrote $size bytes; differs from original $original_path"
    fi
  else
    echo "    wrote $size bytes; no original file for comparison"
  fi
}

if [[ $# -eq 0 ]]; then
  usage >&2
  exit 2
fi

case "$1" in
  --help|-h)
    usage
    exit 0
    ;;
  --list)
    list_probes
    exit 0
    ;;
  all)
    shift
    if [[ $# -ne 0 ]]; then
      echo "'all' cannot be combined with explicit probe names" >&2
      exit 2
    fi
    probes=()
    while IFS= read -r probe; do
      probes+=("$probe")
    done < <(list_probes)
    ;;
  *)
    probes=("$@")
    ;;
esac

if [[ -n "$cart_rom" ]]; then
  require_file "$cart_rom" "Action! cartridge ROM"
fi
if [[ -n "$os_rom" ]]; then
  require_file "$os_rom" "Atari OS ROM"
fi

for probe in "${probes[@]}"; do
  run_probe "$probe"
done
